<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="380.0" spacing="12.0" style="-fx-background-color: #f4f4f9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.edo.RegisterController">

    <!-- Nadpis -->
    <Label text="Vytvorenie účtu">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
        <VBox.margin>
            <Insets bottom="5.0" />
        </VBox.margin>
    </Label>

    <!-- Meno a priezvisko -->
    <VBox spacing="4.0">
        <Label text="Meno:" textFill="#555555" />
        <TextField fx:id="nameField" promptText="Zadajte vaše meno" style="-fx-pref-height: 35; -fx-background-radius: 5;" />
    </VBox>

    <!-- Email -->
    <VBox spacing="4.0">
        <Label text="Email:" textFill="#555555" />
        <TextField fx:id="emailField" promptText="napr. janko@example.com" style="-fx-pref-height: 35; -fx-background-radius: 5;" />
    </VBox>

    <!-- Heslo -->
    <VBox spacing="4.0">
        <Label text="Heslo:" textFill="#555555" />
        <PasswordField fx:id="passwordField" promptText="Vytvorte si heslo" style="-fx-pref-height: 35; -fx-background-radius: 5;" />
    </VBox>

    <!-- Potvrdenie hesla -->
    <VBox spacing="4.0">
        <Label text="Potvrdenie hesla:" textFill="#555555" />
        <PasswordField fx:id="confirmPasswordField" promptText="Zopakujte heslo" style="-fx-pref-height: 35; -fx-background-radius: 5;" />
    </VBox>

    <!-- Tlačidlo Registrovať -->
    <Button fx:id="registerButton" maxWidth="Infinity" onAction="#handleRegisterAction" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-background-radius: 5; -fx-cursor: hand;" text="Vytvoriť účet">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Button>

</VBox>
