<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: #f4f4f9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.edo.controllers.LoginController">

    <Label text="Prihlásenie">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </Label>

    <VBox spacing="5.0">
        <Label text="Používateľské meno / Email:" textFill="#555555" />
        <TextField fx:id="usernameField" promptText="Zadajte meno alebo email" style="-fx-pref-height: 35; -fx-background-radius: 5;" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Heslo:" textFill="#555555" />
        <PasswordField fx:id="passwordField" promptText="Zadajte heslo" style="-fx-pref-height: 35; -fx-background-radius: 5;" />

        <Hyperlink alignment="CENTER_RIGHT" contentDisplay="RIGHT" onAction="#handleForgotPassword" prefHeight="24.0" prefWidth="105.0" style="-fx-text-fill: #6c757d; -fx-underline: false;" text="Zabudli ste heslo?" textAlignment="RIGHT" />
    </VBox>

    <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLoginAction" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-background-radius: 5; -fx-cursor: hand;" text="Prihlásiť sa" />
    <Button fx:id="createAccountButton" maxWidth="Infinity" onAction="#createAccountButtonOnAction" style="-fx-background-color: #ffffff; -fx-text-fill: #007bff; -fx-font-weight: bold; -fx-pref-height: 40; -fx-background-radius: 5; -fx-cursor: hand;" text="Vytvoriť účet" />

</VBox>
